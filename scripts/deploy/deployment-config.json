{
  "framework": {
    "name": "AI QC Framework",
    "version_current": "1.0.0",
    "phases": {
      "phase_1": {
        "name": "Core Validation Tools",
        "status": "ACTIVE",
        "tools": [
          "requirement-validator",
          "user-story-analyzer",
          "test-case-generator",
          "acceptance-criteria-checker"
        ]
      },
      "phase_2": {
        "name": "Advanced Testing Tools",
        "status": "PLANNED",
        "deployment_target": "Week 2",
        "tools": [
          "regression-test-suite",
          "performance-test-runner",
          "security-test-scanner",
          "integration-test-executor"
        ]
      },
      "phase_3": {
        "name": "Automation & CI/CD Tools",
        "status": "PLANNED",
        "deployment_target": "Week 3",
        "tools": [
          "test-automation-framework",
          "ci-cd-pipeline",
          "deployment-validator",
          "monitoring-dashboard"
        ]
      },
      "phase_4": {
        "name": "Production Tools",
        "status": "PLANNED",
        "deployment_target": "Week 4",
        "tools": [
          "production-health-monitor",
          "canary-deployment-manager",
          "gradual-rollout-orchestrator",
          "rollback-automation",
          "metrics-collector",
          "alerting-system",
          "documentation-generator"
        ]
      }
    }
  },
  "environments": {
    "staging": {
      "path": "c:/staging",
      "description": "Staging environment for Phase 2-4 validation",
      "backup_retention_days": 7,
      "backup_count_keep": 5,
      "health_check_interval_seconds": 300,
      "tools_to_deploy": [
        "regression-test-suite",
        "performance-test-runner",
        "security-test-scanner",
        "integration-test-executor",
        "test-automation-framework",
        "ci-cd-pipeline",
        "deployment-validator",
        "monitoring-dashboard",
        "production-health-monitor",
        "canary-deployment-manager",
        "gradual-rollout-orchestrator",
        "rollback-automation",
        "metrics-collector",
        "alerting-system",
        "documentation-generator"
      ]
    },
    "production": {
      "path": "c:/production",
      "description": "Production environment with full deployment",
      "backup_retention_days": 30,
      "backup_count_keep": 10,
      "monitoring_duration_minutes": 1800,
      "health_check_interval_seconds": 60
    }
  },
  "deployment_strategy": {
    "canary": {
      "enabled": true,
      "percentage": 5,
      "monitoring_duration_hours": 24,
      "failure_rate_threshold": 5,
      "error_rate_threshold": 5,
      "latency_p95_threshold_ms": 1000,
      "cpu_usage_threshold": 85,
      "memory_usage_threshold": 85
    },
    "gradual_rollout": {
      "enabled": true,
      "stages": [
        {
          "percentage": 5,
          "name": "Initial Stage",
          "monitoring_duration_minutes": 30,
          "total_users": 5000
        },
        {
          "percentage": 25,
          "name": "Expanded Stage",
          "monitoring_duration_minutes": 30,
          "total_users": 25000
        },
        {
          "percentage": 50,
          "name": "Majority Stage",
          "monitoring_duration_minutes": 30,
          "total_users": 50000
        },
        {
          "percentage": 100,
          "name": "Full Release",
          "monitoring_duration_minutes": 0,
          "total_users": 100000
        }
      ],
      "failure_rate_threshold": 5,
      "auto_rollback_enabled": true
    }
  },
  "metrics": {
    "staging": {
      "retry_success_rate_requirement": 90,
      "cleanup_success_rate_requirement": 100,
      "health_check_pass_rate_requirement": 100,
      "test_pass_rate_requirement": 95
    },
    "production": {
      "error_rate_threshold": 5,
      "latency_p95_threshold_ms": 1000,
      "cpu_usage_threshold": 85,
      "memory_usage_threshold": 85,
      "disk_space_min_gb": 10,
      "memory_available_min_gb": 2
    }
  },
  "health_checks": {
    "enabled": true,
    "checks": [
      {
        "name": "Database Connectivity",
        "type": "connection",
        "timeout_seconds": 10,
        "retry_count": 3
      },
      {
        "name": "API Endpoint Health",
        "type": "http",
        "endpoint": "http://localhost/health",
        "expected_status": 200,
        "timeout_seconds": 5
      },
      {
        "name": "Cache System",
        "type": "connection",
        "timeout_seconds": 5
      },
      {
        "name": "Messaging System",
        "type": "connection",
        "timeout_seconds": 5
      },
      {
        "name": "Disk Space",
        "type": "system",
        "minimum_gb": 10
      },
      {
        "name": "Memory Available",
        "type": "system",
        "minimum_gb": 2
      }
    ]
  },
  "logging": {
    "enabled": true,
    "log_level": "INFO",
    "log_retention_days": 30,
    "log_format": "json",
    "log_directory": "./deployment-logs",
    "archive_on_completion": true
  },
  "notifications": {
    "enabled": true,
    "events": [
      "deployment_started",
      "deployment_completed",
      "deployment_failed",
      "rollback_initiated",
      "metrics_threshold_exceeded",
      "stage_completed"
    ],
    "channels": [
      {
        "type": "email",
        "recipients": ["ops-team@company.com", "devops-lead@company.com"],
        "on_events": ["deployment_failed", "rollback_initiated"]
      },
      {
        "type": "slack",
        "webhook": "https://hooks.slack.com/services/XXX/YYY/ZZZ",
        "channel": "#deployments",
        "on_events": ["deployment_started", "deployment_completed", "deployment_failed"]
      }
    ]
  },
  "rollback": {
    "enabled": true,
    "auto_rollback_on_failure": true,
    "failure_rate_threshold": 5,
    "backup_storage": "c:/production/backups",
    "backup_compression": true,
    "restore_data": true,
    "restore_config": true,
    "health_check_after_rollback": true
  },
  "timing": {
    "pre_deployment_check_timeout_seconds": 300,
    "backup_timeout_seconds": 900,
    "deployment_timeout_seconds": 1800,
    "test_execution_timeout_seconds": 3600,
    "metrics_verification_timeout_seconds": 300,
    "canary_monitoring_timeout_seconds": 86400,
    "stage_monitoring_timeout_seconds": 1800,
    "rollback_timeout_seconds": 600,
    "health_check_timeout_seconds": 60
  },
  "deployment_timeline": {
    "week_1": {
      "phase": "Phase 2 Staging",
      "activities": [
        "Pre-deployment validation",
        "Deploy Phase 2 tools to staging",
        "Run full test suite",
        "Verify metrics (90%+ success rate)"
      ]
    },
    "week_2": {
      "phase": "Phase 2 Production",
      "activities": [
        "Canary deployment (5% users, 24hr monitoring)",
        "Gradual rollout if canary passes",
        "Monitor metrics (5% → 25% → 50% → 100%)",
        "Production stabilization"
      ]
    },
    "week_3": {
      "phase": "Phase 3 Deployment",
      "activities": [
        "Repeat staging process",
        "Canary deployment",
        "Gradual rollout",
        "Production stabilization"
      ]
    },
    "week_4": {
      "phase": "Phase 4 Deployment",
      "activities": [
        "Final phase deployment",
        "Comprehensive testing",
        "Full production rollout",
        "Framework stabilization"
      ]
    },
    "week_5_6": {
      "phase": "Production Stabilization",
      "activities": [
        "Monitor all systems",
        "Address any issues",
        "Performance optimization",
        "Documentation updates"
      ]
    }
  },
  "validation": {
    "pre_deployment_checks": [
      "Framework path validation",
      "Tool directory existence",
      "Configuration file format (JSON)",
      "Disk space availability",
      "Memory availability",
      "Network connectivity"
    ],
    "tool_validation": [
      "Tool directory exists",
      "Config file present and valid",
      "Dependencies available",
      "Required executables present"
    ]
  },
  "version_control": {
    "track_versions": true,
    "version_file": "VERSION",
    "changelog_file": "CHANGELOG.md",
    "tag_deployments": true,
    "git_enabled": true
  }
}
